{
  "name": "face-expression-vfx",
  "version": "3.11.0",
  "private": true,
  "description": "Privacy-first, quality-gated FACS-inspired facial action unit visualization with uncertainty",
  "scripts": {
    "start": "npx http-server . -p 8080 -o",
    "test": "node tests/run-tests.mjs",
    "evaluate": "node scripts/evaluate-au.mjs evaluation/fixtures/synthetic-au-eval.json",
    "quality": "node scripts/quality-check.mjs",
    "lint": "eslint *.js scripts/*.mjs tests/*.mjs",
    "check": "npm run test && npm run evaluate && npm run lint && npm run quality",
    "icons": "node icons/generate-icons.mjs"
  },
  "keywords": [
    "face-mesh",
    "micro-expression",
    "FACS",
    "action-units",
    "uncertainty",
    "mediapipe"
  ],
  "license": "MIT",
  "devDependencies": {
    "eslint": "^10.9.1",
    "globals": "^17.11.0"
  }
}
